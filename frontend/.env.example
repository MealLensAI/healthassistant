VITE_AI_API_URL = https://ai-production-95c7.up.railway.app
VITE_IMAGES_API_URL = https://getimages-production-8c05.up.railway.app

# Care marketplace uses the same Flask /api proxy (no second backend).
# Default: API on. Set VITE_USE_API=false to use browser-only mock seed data.
# VITE_USE_API=false

# Admin verification console (/admin) — email + password gate.
# Backend (Flask) — preferred format (email:password pairs):
#   CARE_ADMIN_CREDENTIALS=admin@healthyyou.com:changeme,admin@meallensai.com:changeme
# Or shared password for every CARE_ADMIN_EMAILS entry:
#   CARE_ADMIN_EMAILS=admin@healthyyou.com,admin@meallensai.com
#   CARE_ADMIN_PASSWORD=changeme
#
# Frontend allowlist (optional; used for role redirects). Keep in sync with backend emails:
# VITE_CARE_ADMIN_EMAILS=admin@healthyyou.com,admin@meallensai.com
